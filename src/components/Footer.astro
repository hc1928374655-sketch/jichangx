---
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <!-- 上半区：4 栏布局 -->
    <div class="footer-grid">
      <!-- 品牌信息与定位 -->
      <div class="footer-col brand-col">
        <div class="footer-logo">
          <span class="logo-name">2026<span class="highlight">机场推荐</span></span>
        </div>
        <p class="brand-desc">
          专注提供全球网络加速节点、IEPL/IPLC 跨境专线实测、4K 流媒体解锁监测与全平台客户端配置指南。立足客观数据，拒绝盲目跟风。
        </p>
      </div>

      <!-- 快速导航 -->
      <div class="footer-col">
        <h4 class="footer-title">快速导航</h4>
        <ul class="footer-links">
          <li><a href="/">首页</a></li>
          <li><a href="/rankings">2026 机场评测总榜</a></li>
          <li><a href="/reviews">品牌深度评测报告</a></li>
          <li><a href="/blog/kexin-cloud-review">可信云旗舰专线评测</a></li>
          <li><a href="/tutorials">客户端保姆级教程</a></li>
          <li><a href="/faq">新手常见问题答疑</a></li>
        </ul>
      </div>

      <!-- 热门专题与推荐分类 -->
      <div class="footer-col">
        <h4 class="footer-title">专题推荐</h4>
        <ul class="footer-links">
          <li><a href="/category/reviews">IEPL 纯专线横评</a></li>
          <li><a href="/category/guides">Netflix / Disney+ 解锁测试</a></li>
          <li><a href="/category/guides">ChatGPT / Claude 原生节点指南</a></li>
          <li><a href="/blog/kexin-cloud-review">站长主推：可信云测评</a></li>
          <li><a href="/category/tutorials">Clash Verge Rev 进阶配置</a></li>
          <li><a href="/category/tutorials">Sing-box 全规则分流实战</a></li>
        </ul>
      </div>

      <!-- 合规与法律声明 -->
      <div class="footer-col">
        <h4 class="footer-title">信任与合规</h4>
        <ul class="footer-links">
          <li><a href="/about">关于本站与测试基准</a></li>
          <li><a href="/disclaimer">免责声明与服务条款</a></li>
          <li><a href="/faq">如何判断机场是否稳定</a></li>
          <li><a href="/comparisons">主流专线横向测速对比</a></li>
          <li><a href={siteConfig.telegramChannelPlaceholder} target="_blank" rel="nofollow noopener">TG 监控与防失联通知</a></li>
        </ul>
      </div>
    </div>

    <!-- 底部内链关键词云（提升 SEO 索引与相关性） -->
    <div class="footer-keywords">
      <span class="kw-label">收录标签：</span>
      <div class="kw-tags">
        {siteConfig.keywords.map(kw => (
          <span class="kw-tag">#{kw}</span>
        ))}
      </div>
    </div>

    <!-- 底部版权栏 -->
    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} {siteConfig.name}. 保留所有权利。本站内容仅用于网络性能测试与技术学术交流，请遵守所在地区法律法规。
      </p>
      <div class="bottom-links">
        <a href="/about">关于我们</a>
        <span class="sep">·</span>
        <a href="/disclaimer">免责条款</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #06080e;
    border-top: 1px solid var(--border-light);
    padding-top: 3.5rem;
    padding-bottom: 2.5rem;
    position: relative;
    z-index: 10;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 2.5rem;
  }

  .footer-logo .logo-name {
    font-size: 1.4rem;
    font-weight: 800;
    color: #ffffff;
  }

  .footer-logo .highlight {
    background: var(--grad-brand);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .brand-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin: 1.1rem 0 0;
    line-height: 1.75;
    max-width: 320px;
  }

  .footer-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1.2rem;
    letter-spacing: -0.01em;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .footer-links a:hover {
    color: var(--accent-cyan);
    transform: translateX(2px);
    display: inline-block;
  }

  .footer-keywords {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    margin-bottom: 2rem;
    font-size: 0.82rem;
  }

  .kw-label {
    color: var(--text-dim);
    white-space: nowrap;
    font-weight: 600;
  }

  .kw-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .kw-tag {
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.82rem;
    color: var(--text-dim);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .bottom-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bottom-links a {
    color: var(--text-dim);
  }
  .bottom-links a:hover {
    color: var(--text-main);
  }

  .sep {
    opacity: 0.4;
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .brand-col {
      grid-column: span 2;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .brand-col {
      grid-column: span 1;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
