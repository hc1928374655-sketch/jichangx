---
const featureCards = [
  {
    title: "4K / 8K 流媒体沉浸党",
    tag: "Netflix · Disney+ · TikTok",
    description: "专为追剧达人定制。甄选具备原生家庭住宅双 ISP、DNS 双向解锁及超大冗余带宽节点，彻底告别 1080P 降画质与“代理检测警告”。",
    badge: "流媒体强解",
    link: "/category/guides",
    iconColor: "#38bdf8",
    bullets: ["解锁 Netflix 非自制剧", "支持 Disney+ 4K HDR", "动态自动轮换无污染落地"]
  },
  {
    title: "AI 生成与跨境商务办公",
    tag: "ChatGPT · Claude · 外贸协同",
    description: "高风控平台专属利器。采用纯净无滥用记录的住宅 IP 落地，完美通过 OpenAI / Claude 严格欺诈检测，保障跨境账号安全与长期运营。",
    badge: "高风控适配",
    link: "/category/guides",
    iconColor: "#34d399",
    bullets: ["ChatGPT 4.0 绝不拒登", "双向住宅 ISP 纯净路由", "支持多人团队多设备并发"]
  },
  {
    title: "极客网络与全天候晚高峰",
    tag: "IEPL 纯内网专线 · 零丢包",
    description: "拒绝公网拥堵中继。采用点对点物理内网专线，避开晚高峰骨干网 QoS 限速，游戏与远程 SSH 延迟波动控制在 2ms 极限范围内。",
    badge: "物理专线",
    link: "/category/reviews",
    iconColor: "#fbbf24",
    bullets: ["晚高峰丢包率 < 0.1%", "广州/上海物理内网直通", "全天候峰值带宽跑满"]
  },
  {
    title: "轻量使用与防失联备用",
    tag: "按量计费 · 永久不过期",
    description: "出差应急与轻度查询用户的省钱神器。无需每月按期交月租，用多少扣多少，账户余额长期有效，多一个备用通道永远不慌。",
    badge: "永不过期",
    link: "/category/reviews",
    iconColor: "#c084fc",
    bullets: ["不限使用时间与期限", "低至 10 元起步充值", "出差与应急防失联首选"]
  }
];
---

<section class="feature-grid-section">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-tag">场景选购导航</span>
      <h2 class="section-title">按需选择，拒绝踩坑</h2>
      <p class="section-subtitle">
        不同使用场景对专线、IP纯净度与计费模式的要求截然不同。点击下方对应分类，即可直达精选评测。
      </p>
    </div>

    <div class="features-grid">
      {featureCards.map((card) => (
        <a href={card.link} class="feature-card glass-card interactive-card">
          <div class="card-top">
            <span class="card-badge" style={`color: ${card.iconColor}; border-color: ${card.iconColor}40; background: ${card.iconColor}15;`}>
              {card.badge}
            </span>
            <span class="card-tag-text">{card.tag}</span>
          </div>

          <h3 class="card-heading">{card.title}</h3>
          <p class="card-desc">{card.description}</p>

          <ul class="card-bullets">
            {card.bullets.map((b) => (
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={card.iconColor} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>

          <div class="card-footer-link" style={`color: ${card.iconColor}`}>
            <span>查看匹配评测 &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .feature-grid-section {
    padding: 3.5rem 0;
  }

  .text-center {
    text-align: center;
  }
  .section-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    text-decoration: none;
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .card-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-full);
    border: 1px solid transparent;
  }

  .card-tag-text {
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  .card-heading {
    font-size: 1.3rem;
    font-weight: 750;
    color: #ffffff;
    margin-bottom: 0.65rem;
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .card-bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .card-bullets li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    color: var(--text-main);
  }

  .card-footer-link {
    font-size: 0.88rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  @media (max-width: 768px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
