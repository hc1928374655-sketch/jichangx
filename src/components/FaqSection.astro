---
interface FaqItem {
  question: string;
  answer: string;
}

const faqs: FaqItem[] = [
  {
    question: "什么是 IEPL / IPLC 专线？为什么比普通公网中转贵且更稳定？",
    answer: "IEPL (International Ethernet Private Line) 和 IPLC 是端到端物理内网专线。普通公网中转的数据在出海时需要走公网国际出口，在晚高峰（20:00-23:00）会面临严重的骨干网拥堵与 QoS 限速；而 IEPL 专线走的是陆地光缆内网直连（例如深圳-香港直通），不过公网审查，延迟极低（30ms以内）且丢包率几乎为 0，因此成本更高但体验极佳。"
  },
  {
    question: "为什么很多机场无法顺畅使用 ChatGPT 或 Netflix？",
    answer: "OpenAI 和 Netflix 等流媒体平台部署了严格的商业机房 IP 黑名单数据库。如果机场节点采用的是普通的机房数据中心 IP（Hosting/Data Center），就会触发拒绝访问或 Netflix 仅显示自制剧。优质机场会采用原生家庭住宅双 ISP IP，或者搭建针对流媒体和 AI 域名的专用 DNS 解锁服务器分流。"
  },
  {
    question: "按量付费（流量不限时）和按月订阅应该怎么选？",
    answer: "如果您是重度用户、每天刷 4K 视频或下载大文件，按月订阅（例如每月 100GB-300GB 档位）单价最划算；如果您平时很少用，仅偶尔查资料、出国出差应急，或者需要准备一条‘防失联备用梯’，那么选择按量付费（按用量扣费，账户余额不限期）最为经济划算。"
  },
  {
    question: "如何防范机场服务商‘跑路’风险？",
    answer: "老手选购的核心原则：① 严禁一次性购买 2 年甚至 3 年的所谓‘超值传家宝’套餐，尽量按月付或季付；② 优先选择运营时间超过 3-5 年的老牌大厂；③ 随时准备两家不同线路架构的机场（一主一备），避免单点故障导致工作停摆。"
  },
  {
    question: "Clash、Sing-box、Shadowrocket 哪款客户端更适合新手？",
    answer: "Windows 和 macOS 平台目前首选 Clash Verge Rev，界面现代化、自带中文内核一键切换，对新手最友好；iOS 平台建议使用美区 App Store 购买的 Shadowrocket（小火箭）或 Sing-box；安卓平台推荐 Clash Meta for Android 或 Sing-box。本站‘客户端教程’板块有图文步骤指引。"
  }
];

// 生成 FAQPage Schema.org 结构化数据
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<section id="faq" class="faq-section">
  <!-- 注入结构化数据 -->
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <div class="container faq-container">
    <div class="section-header text-center">
      <span class="section-tag">新手避坑指南</span>
      <h2 class="section-title">常见疑问与专线科普</h2>
      <p class="section-subtitle">
        新手选购机场前必读的关键常识，助您快速识别虚假宣传，选出最适合自己的稳定网络方案。
      </p>
    </div>

    <div class="faq-list">
      {faqs.map((faq, index) => (
        <details class="faq-item glass-card" open={index === 0}>
          <summary class="faq-question">
            <span class="q-icon">Q</span>
            <span class="q-text">{faq.question}</span>
            <span class="toggle-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="faq-answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section {
    padding: 3.5rem 0;
  }

  .text-center {
    text-align: center;
  }
  .section-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .faq-container {
    max-width: 880px;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
  }

  .faq-item {
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .faq-question {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .q-icon {
    font-size: 0.82rem;
    font-weight: 800;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    flex-shrink: 0;
  }

  .q-text {
    flex: 1;
    line-height: 1.45;
  }

  .toggle-icon {
    color: var(--text-dim);
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  details[open] .toggle-icon {
    transform: rotate(180deg);
    color: var(--accent-cyan);
  }

  details[open] {
    border-color: rgba(56, 189, 248, 0.3);
  }

  .faq-answer {
    padding: 0 1.5rem 1.35rem 3.4rem;
    color: var(--text-muted);
    font-size: 0.94rem;
    line-height: 1.75;
  }

  .faq-answer p {
    margin: 0;
  }

  @media (max-width: 600px) {
    .faq-answer {
      padding-left: 1.5rem;
    }
  }
</style>
