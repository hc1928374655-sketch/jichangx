---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RankingTable from '../../components/RankingTable.astro';

const breadcrumbItems = [
  { title: '首页', href: '/' },
  { title: '机场综合榜' }
];
---

<BaseLayout
  title="2026 机场综合榜 - 主流优质网络专线横评天梯榜"
  description="2026 机场综合测速天梯榜单：基于实验室为期 30 天 24 小时全自动监测数据，全面评估晚高峰带宽跑满率、丢包率、4K 流媒体解锁稳定性及性价比，客观呈现顶级 IEPL 专线综合实力排名与专属优惠福利。"
>
  <div class="container archive-container">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <RankingTable />
</BaseLayout>

<style>
  .archive-container {
    padding-top: 2rem;
  }
</style>
