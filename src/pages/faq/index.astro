---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FaqSection from '../../components/FaqSection.astro';

const breadcrumbItems = [
  { title: '首页', href: '/' },
  { title: '防坑指南' }
];
---

<BaseLayout
  title="新手避坑指南与常见问题解答 - 2026机场推荐"
  description="新手选购机场前必读的关键常识与常见避坑指南：全面科普 IEPL/IPLC 专线与直连差异、Netflix/ChatGPT 原生流媒体解锁原理、全平台客户端推荐以及如何规避跑路风险，解答节点导入配置与网络常见故障疑惑。"
>
  <div class="container archive-container">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <FaqSection />
</BaseLayout>

<style>
  .archive-container {
    padding-top: 2rem;
  }
</style>
